{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"e2e/*.ts\" next.config.ts playwright.config.ts playwright.production.config.ts tsconfig.json tsconfig.tests.json",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit --project tsconfig.tests.json",
    "pretest": "playwright install --with-deps chromium",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:ui": "playwright test --ui",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"e2e/*.ts\" next.config.ts playwright.config.ts playwright.production.config.ts tsconfig.json tsconfig.tests.json"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.6",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "prettier": "3.6.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
