.env
.env.*
!.env.example

# graphify: machine-local hook paths (re-create with `graphify claude install`)
.claude/settings.local.json

# graphify: all outputs are machine-local now (regenerate with `graphify update .`)
graphify-out/

# graphify: local scan cache (mtime/seen timestamps), dated backups
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/manifest.json
